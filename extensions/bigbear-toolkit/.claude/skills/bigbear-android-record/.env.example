# ============================================================
# 设备视觉识别服务（Device Vision）环境变量配置
# 说明：本文件用于配置 Android 设备屏幕视觉识别所需的
#       大模型 API 信息，调用方为 bigbear-android-record 录制工具
# ============================================================

# 视觉识别服务 API Key（鉴权凭证，请妥善保管，不要提交到公开仓库）
DEVICE_VISION_API_KEY=

# 视觉识别服务 Base URL（兼容 OpenAI 格式的接口地址，含 /v1 路径前缀）
DEVICE_VISION_BASE_URL=http://192.168.1.6:13000/v1

# 视觉识别使用的模型名称（当前使用 qwen3.6-35b，可按实际部署替换）
DEVICE_VISION_MODEL=qwen3.6-35b
