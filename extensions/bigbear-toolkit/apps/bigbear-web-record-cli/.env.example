# 多模态 AI 截图分析（可选功能）
# 启用方法：pip install -e ".[vision]" 或 pip install openai
# 配置 API Key 和 Base URL 后，在命令后加 --enable-vision 即可开启截图 AI 分析

# 多模态 API Key
WEB_VISION_API_KEY=sk-xxxxxx

# 多模态 API Base URL（OpenAI 兼容格式）
WEB_VISION_BASE_URL=https://api.example.com/v1

# 多模态模型
WEB_VISION_MODEL=qwen3.6-flash-2026-04-16
