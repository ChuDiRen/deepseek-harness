# BigBear Web CLI Configuration
# 复制此文件为 .env 并填入您的配置

# AI API 配置（WEB_AUTOMATION_ 前缀）
WEB_AUTOMATION_AI_API_KEY=
WEB_AUTOMATION_AI_BASE_URL=http://192.168.1.37:11435/v1
WEB_AUTOMATION_AI_MODEL=qwen3.6-35b

ANDROID_AI_API_KEY=
ANDROID_AI_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
ANDROID_AI_MODEL=astron-code-latest

AI_API_KEY=
AI_BASE_URL=http://192.168.1.37:11435/v1
AI_MODEL=qwen3.6-35b

# WEB_AUTOMATION_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# WEB_AUTOMATION_AI_MODEL=qwen3.6-plus

# 浏览器数据目录（用于保持会话、Cookie等）
WEB_AUTOMATION_USER_DATA=./user_data

# browser-use
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_MODEL=qwen3.5-122b-a10b


ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_MODEL=MiniMax-M2.7




# ==================== Appium 服务器配置 ====================
# Appium 服务地址
APPIUM_HOST=192.168.1.42
# Appium 服务端口
APPIUM_PORT=4723
# Appium 服务路径（通常留空）
APPIUM_PATH=

# ==================== 设备 Capabilities 配置 ====================
# 平台名称: Android / iOS
APPIUM_PLATFORM_NAME=Android
# 平台版本
APPIUM_PLATFORM_VERSION=13
# 设备名称（adb devices 中的名称，如 emulator-5554）
APPIUM_DEVICE_NAME=3433242254001VO
# 自动化引擎: Android 用 uiautomator2，iOS 用 XCUITest
APPIUM_AUTOMATION_NAME=uiautomator2
# 新命令超时时间（秒）
APPIUM_NEW_COMMAND_TIMEOUT=120