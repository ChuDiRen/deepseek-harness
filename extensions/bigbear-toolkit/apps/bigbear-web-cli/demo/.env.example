# 复制此文件为 .env 并填入你的真实配置
#   Windows:   copy .env.example .env
#   macOS/Linux: cp .env.example .env

# ============================================
# AI 接口配置（Demo 2 和 Demo 3 的 Step 4/8 需要）
# ============================================

# AI 服务的 API Key（必填）
WEB_AUTOMATION_AI_API_KEY=your_api_key_here

# AI 服务的基础 URL
# 阿里云百炼示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方示例：https://api.openai.com/v1
WEB_AUTOMATION_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（不同服务不一样，按你用的填）
# 阿里云示例：qwen-vl-plus
# OpenAI 示例：gpt-4o
WEB_AUTOMATION_AI_MODEL=qwen-vl-plus

# ============================================
# 说明
# ============================================
# 1. Demo 1（hardcoded）不需要这些，可以不配直接跑
# 2. Demo 2 和 Demo 3 的 Step 4/8 会读这个文件
# 3. 没有真实 Key 的话，去对应平台注册账号拿：
#    - 阿里云百炼：https://bailian.console.aliyun.com/
#    - OpenAI：https://platform.openai.com/