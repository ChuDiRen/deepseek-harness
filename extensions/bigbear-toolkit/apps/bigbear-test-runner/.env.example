# bigbear-test-runner 可选环境变量
# 复制为 .env 后由 python-dotenv 加载,override=False

# ─────────────────────────── 2026-07-13 更新 ───────────────────────────
# AGENT_AI_SKILLS_DIR 已废弃,请改用 CLI 参数 --skills-dir 传入 skill 根目录。
# 示例: --skills-dir D:\\work\\skills-a --skill bigbear-web-cli


# ─────────────────────────── Agent 任务 AI 配置 ───────────────────────────
AGENT_AI_API_KEY=
AGENT_AI_BASE_URL=http://192.168.1.6:13000/v1
AGENT_AI_MODEL=MiniMax-M3

