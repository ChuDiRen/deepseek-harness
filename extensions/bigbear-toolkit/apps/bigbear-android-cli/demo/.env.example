# 复制此文件为 .env 并填入你的真实配置
#   Windows:   copy .env.example .env
#   macOS/Linux: cp .env.example .env

# ============================================
# AI 接口配置（Demo 2 和 Demo 3 的 Step 4/8 需要）
# 注意前缀是 ANDROID_AI_（不是 WEB_AUTOMATION_AI_）
# ============================================

# AI 服务的 API Key
ANDROID_AI_API_KEY=your_api_key_here

# AI 服务的基础 URL
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI：https://api.openai.com/v1
ANDROID_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（必须是视觉模型！）
# 阿里云：qwen-vl-plus、qwen-vl-max、qwen2-vl-72b
# OpenAI：gpt-4o、gpt-4-vision-preview
ANDROID_AI_MODEL=qwen-vl-plus

# ============================================
# adb 相关（一般不用填，默认走 PATH）
# ============================================

# 如果 adb 不在 PATH，填完整路径
# Windows: C:\Users\yourname\AppData\Local\Android\Sdk\platform-tools\adb.exe
# macOS:   /Users/yourname/Library/Android/sdk/platform-tools/adb
# ANDROID_ADB_PATH=

# 默认设备序列号（不填就用 adb devices 的第一个）
# ANDROID_DEFAULT_DEVICE=emulator-5554