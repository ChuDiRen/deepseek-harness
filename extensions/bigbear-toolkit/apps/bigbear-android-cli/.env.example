# AI 视觉识别配置
# 讯飞 MaaS（OpenAI 兼容模式）示例：
#   ANDROID_AI_API_KEY=<appid>:<api_secret>
#   ANDROID_AI_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
#   ANDROID_AI_MODEL=astron-code-latest
# 阿里云 DashScope（qwen-vl-max 等视觉模型）示例：
#   ANDROID_AI_API_KEY=sk-xxx
#   ANDROID_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   ANDROID_AI_MODEL=qwen-vl-max
ANDROID_AI_API_KEY=your_api_key_here
ANDROID_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANDROID_AI_MODEL=qwen-vl-max

# 设备配置（可选）
# ANDROID_DEFAULT_DEVICE=emulator-5554

# adb 可执行路径（可选，默认从 PATH 查找）
# ANDROID_ADB_PATH=/path/to/adb